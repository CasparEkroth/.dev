# --- LLM connection -----------------------------------------------------
# Base URL of the OpenAI-compatible chat/completions endpoint.
LLM_BASE_URL=https://api.x.ai/v1/chat/completions
LLM_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# For Azure, this is the deployment name, not a model id.
LLM_MODEL=grok-4.5

# xai | azure | openai.
# (".openai.azure.com" -> azure, "x.ai" -> xai, anything else -> openai).
LLM_PROVIDER=

# Only used when LLM_PROVIDER=azure.
AZURE_API_VERSION=2024-10-21

# true/false only — do NOT set this to "" (empty string fails to parse and
# crashes on startup). Omit the line entirely if you want the default (false).
LLM_REASONING_MODEL=false

# --- Other services -------------------------------------------------------
HF_TOKEN=
TAVILY_API_KEY=
