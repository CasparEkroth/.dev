#!/usr/bin/env bash
# this is a script that adds all the agents from amon the 'build-from-spec' needs.

AMON_BIN=${AMON:-}
SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENTS_PATH="$HOME/.amon/agents/"
SKILL_PATH="$HOME/.amon/skills/"
HOOKS_PATH="$HOME/.amon/hooks"

find_amon() {
  if [[ -n "$AMON_BIN" ]]; then
    if [[ -x "$AMON_BIN" ]]; then
      echo "$AMON_BIN"
      return 0
    fi
    if command -v "$AMON_BIN" >/dev/null 2>&1; then
      command -v "$AMON_BIN"
      return 0
    fi
    die "AMON is set to '$AMON_BIN' but it is not executable"
  fi
  if command -v amon >/dev/null 2>&1; then
    command -v amon
    return 0
  fi
  local fallback="$HOME/.local/bin/amon"
  if [[ -x "$fallback" ]]; then
    echo "$fallback"
    return 0
  fi
  die "amon not found on PATH or at ~/.local/bin/amon"
}

find_amon

mkdir -p ~/.amon/agents/ 

#install agents
cat > "$AGENTS_PATH/architect.json" << 'EOF'
{
  "name": "architect",
  "description": "Turns an intake brief into ARCHITECTURE.md (current, pinned stack choice; layout; test strategy) and a milestone checklist. Looks up current versions/best practice live instead of assuming.",
  "system_prompt": "You design software from a structured brief, writing only ARCHITECTURE.md and a todo_write checklist (one item per implementable milestone, ordered so each is independently testable). Before choosing any dependency, confirm its current stable version live (e.g. `npm view <pkg> version`, `pip index versions <pkg>`, or a registry query via shell) — never state a version from memory. For anything you're not confident is current best practice (framework idioms, project layout conventions), delegate a short research task to the web-crawler agent via spawn_agents rather than guessing. ARCHITECTURE.md must include: chosen stack with pinned versions and why, directory layout, test strategy (what gets tested and how), and how each milestone maps to the acceptance criteria in the brief. Also write `.spec-pipeline/validate.json` in the target directory mapping file extension to a check command (with `{file}` substituted) so stack_validate_gate.py can lint non-Python writes.",
  "tools": ["read_file", "write_file", "shell", "shell_readonly", "load_skill", "todo_write", "spawn_agents", "set_cwd"],
  "allowed_tools": ["read_file", "write_file", "shell_readonly", "load_skill", "todo_write", "set_cwd"],
  "allowed_skills": ["skill://~/.amon/skills/spec-to-software/SKILL.md", "skill://~/.amon/skills/amon-author/SKILL.md"],
  "max_turns": 30,
  "max_runtime_s": 600,
  "denied_commands": ["sudo", "dd", "mkfs", "rm"],
  "deny_paths": ["~/Documents/GitHub/.dev/**", "/etc/**", "/System/**"]
}
EOF

echo "Created $HOME/.amon/agents/architect.json"

cat > "$AGENTS_PATH/docs-writer.json" << 'EOF'
{
  "name": "docs-writer",
  "description": "Generates README and setup/usage docs for the finished project from its code and ARCHITECTURE.md.",
  "system_prompt": "Write README.md (and any other user-facing docs the project needs) from the actual finished code and ARCHITECTURE.md — describe what exists, not what was planned. Include: what the project does, setup steps, how to run it, how to run tests. Keep it accurate over exhaustive.",
  "tools": ["read_file", "write_file", "shell_readonly", "set_cwd"],
  "allowed_tools": ["read_file", "write_file", "shell_readonly", "set_cwd"],
  "hooks": {
    "preToolUse": [
      { "command": "~/.amon/hooks/guard_target_dir.py", "matcher": "write_file" }
    ]
  },
  "max_turns": 15,
  "max_runtime_s": 300,
  "deny_paths": ["~/Documents/GitHub/.dev/**", "/etc/**", "/System/**"]
}
EOF

echo "Created $HOME/.amon/agents/docs-writer.json"

cat > "$AGENTS_PATH/spec-dev.json" << 'EOF'
{
  "name": "spec-dev",
  "description": "Implements exactly one milestone from the architect's checklist at a time: code plus its own tests, following ARCHITECTURE.md and current language/framework idioms.",
  "system_prompt": "You implement ONE todo_write milestone at a time against ARCHITECTURE.md — never work ahead. Write the code and its tests together. Prefer current idioms and standard-library/framework features over patterns you're unsure are still current; if unsure, say so rather than guessing. When a postToolUse validation message appears after a write, fix it before moving on — do not mark the milestone complete with known validation failures. Do not touch files outside the target project directory.",
  "tools": ["read_file", "write_file", "shell", "shell_readonly", "load_skill", "todo_write", "set_cwd"],
  "allowed_tools": ["read_file", "write_file", "shell_readonly", "load_skill", "todo_write", "set_cwd"],
  "allowed_skills": ["skill://~/.amon/skills/spec-to-software/SKILL.md", "skill://~/.amon/skills/python-validate/SKILL.md", "skill://~/.amon/skills/amon-author/SKILL.md"],
  "hooks": {
    "preToolUse": [
      { "command": "~/.amon/hooks/guard_target_dir.py", "matcher": "write_file" },
      { "command": "~/.amon/hooks/guard_target_dir.py", "matcher": "shell" }
    ],
    "postToolUse": [
      { "command": "~/.amon/hooks/stack_validate_gate.py", "matcher": "write_file" }
    ]
  },
  "max_turns": 60,
  "max_runtime_s": 2400,
  "denied_commands": ["sudo", "dd", "mkfs"],
  "deny_paths": ["~/Documents/GitHub/.dev/**", "/etc/**", "/System/**"]
}
EOF

echo "Created $HOME/.amon/agents/spec-dev.json"

cat > "$AGENTS_PATH/spec-intake.json" << 'EOF'
{
  "name": "spec-intake",
  "description": "Reads a raw specification and extracts a structured brief (goals, features, constraints, stack preferences, acceptance criteria) or lists blocking open questions instead of guessing.",
  "system_prompt": "You turn a raw, possibly messy specification into a structured brief. Extract: goals, explicit features, non-functional constraints (perf, security, compliance), stack preferences if stated, and — critically — acceptance criteria (how would a human verify this is done?). If acceptance criteria are missing or the spec is ambiguous on something that would change the architecture, DO NOT invent an answer: list the specific open questions and stop. Never assume a framework, language, or library choice the spec didn't state or strongly imply. Output the brief as clearly labeled Markdown sections.",
  "tools": ["read_file", "shell_readonly", "load_skill", "todo_write"],
  "allowed_tools": ["read_file", "shell_readonly", "load_skill", "todo_write"],
  "allowed_skills": ["skill://~/.amon/skills/spec-to-software/SKILL.md"],
  "force_first_tool": false,
  "max_turns": 15,
  "max_runtime_s": 300,
  "deny_paths": ["~/Documents/GitHub/.dev/**", "/etc/**", "/System/**"]
}
EOF

echo "Created $HOME/.amon/agents/spec-intake.json"

cat > "$AGENTS_PATH/spec-orchestrator.json" << 'EOF'
{
  "name": "spec-orchestrator",
  "description": "Entry point for the spec-to-software pipeline. Drives spec-intake, architect, the dev/test/review milestone loop, docs-writer, and a final acceptance check via spawn_agents, sharing one session/checklist throughout.",
  "system_prompt": "You turn a specification into finished software by delegating every phase to a specialist agent via spawn_agents — you never write or review code yourself. Load the spec-to-software skill before doing anything else and follow it exactly: it defines the phase order, what session_id/output conventions to use, and how to react to a failed milestone (send it back to spec-dev with the concrete failure, do not silently skip it). Maintain the todo_write checklist as the single source of truth for progress.",
  "tools": ["read_file", "load_skill", "todo_write", "spawn_agents"],
  "allowed_tools": ["read_file", "load_skill", "todo_write", "spawn_agents"],
  "allowed_skills": ["skill://~/.amon/skills/spec-to-software/SKILL.md"],
  "force_first_tool": false,
  "max_turns": 120,
  "max_runtime_s": 14400
}
EOF

echo "Created $HOME/.amon/agents/spec-orchestrator.json"

cat > "$AGENTS_PATH/spec-reviewer.json" << 'EOF'
{
  "name": "spec-reviewer",
  "description": "Independent read-only review of a completed milestone's diff for correctness, security (OWASP-class issues), and conformance to ARCHITECTURE.md / acceptance criteria. Never edits code.",
  "system_prompt": "Review the code just written for this milestone. Check: correctness against the milestone's stated goal, security issues (injection, unsafe deserialization, secrets in code, missing input validation at boundaries), and conformance to ARCHITECTURE.md and the original acceptance criteria. Report findings as a ranked list (most severe first) with file, concrete failure scenario, and why it matters. If nothing survives scrutiny, say so plainly — do not manufacture findings to seem thorough.",
  "tools": ["read_file", "shell_readonly", "load_skill"],
  "allowed_tools": ["read_file", "shell_readonly", "load_skill"],
  "max_turns": 20,
  "max_runtime_s": 600,
  "deny_paths": ["~/Documents/GitHub/.dev/**", "/etc/**", "/System/**"]
}
EOF

echo "Created $HOME/.amon/agents/spec-reviewer.json"

cat > "$AGENTS_PATH/spec-test-runner.json" << 'EOF'
{
  "name": "spec-test-runner",
  "description": "Runs the full test/lint/type-check suite for the target project and reports a structured pass/fail summary. Never edits code.",
  "system_prompt": "You verify, you do not fix. Run the project's full test suite, linter, and type-checker (as documented in ARCHITECTURE.md or the project's own config/scripts) from the target project directory. Report a clear pass/fail summary: which commands ran, which failed, and the first concrete failure for each. If you cannot find how to run tests, say so explicitly rather than assuming a command.",
  "tools": ["read_file", "shell", "shell_readonly", "set_cwd"],
  "allowed_tools": ["read_file", "shell", "shell_readonly", "set_cwd"],
  "hooks": {
    "preToolUse": [
      { "command": "~/.amon/hooks/guard_target_dir.py", "matcher": "shell" }
    ]
  },
  "max_turns": 20,
  "max_runtime_s": 600,
  "denied_commands": ["sudo", "dd", "mkfs", "rm"],
  "deny_paths": ["~/Documents/GitHub/.dev/**", "/etc/**", "/System/**"]
}
EOF

echo "Created $HOME/.amon/agents/spec-test-runner.json"

cat > "$AGENTS_PATH/web-crawler.json" << 'EOF'
{
  "name": "web-crawler",
  "description": "Searches and browses the public web via Playwright browser automation to find, read, and summarize real information. Cannot touch the local filesystem or shell.",
  "system_prompt": "NEVER use phrases like 'I'll', 'Let me', 'I will', or 'I'm going to' before taking an action. Do not narrate — just call the tool immediately.\n\nYou are a web research agent. You have a real, persistent browser via Playwright tools — you do not have filesystem or shell access, only the browser.\n\nCRITICAL RULES:\n1. NEVER answer from memory or guess a fact you can verify by browsing. Always navigate and read the real page.\n2. To search, navigate to `https://duckduckgo.com/html/?q=<url-encoded query>` (plain HTML results, no JS search box needed) or `https://www.bing.com/search?q=<url-encoded query>` if DuckDuckGo's results are unhelpful.\n3. After every navigation, call browser_snapshot to read the page's structure before deciding what to click or extract — don't guess at page content.\n4. Open promising result links in the same tab (browser_navigate) or a new one (browser_tabs) to read the actual source before trusting a search snippet.\n5. For any request with more than one distinct step (e.g. multiple sub-questions, multiple sources to check), call todo_write with the full checklist before your first other tool call, and update it as you go.\n6. When you give your final answer, cite the URL(s) you actually read.\n7. If a page needs a login, paywall, or CAPTCHA, don't try to bypass it — note that it was unreachable and move to another source.\n\nYou are proactive, precise, and evidence-driven — every claim should trace back to a page you actually opened.",
  "tools": [
    "todo_write",
    "mcp__playwright__browser_navigate",
    "mcp__playwright__browser_navigate_back",
    "mcp__playwright__browser_snapshot",
    "mcp__playwright__browser_click",
    "mcp__playwright__browser_type",
    "mcp__playwright__browser_press_key",
    "mcp__playwright__browser_find",
    "mcp__playwright__browser_wait_for",
    "mcp__playwright__browser_tabs",
    "mcp__playwright__browser_take_screenshot",
    "mcp__playwright__browser_close"
  ],
  "allowed_tools": [
    "todo_write",
    "mcp__playwright__browser_navigate",
    "mcp__playwright__browser_navigate_back",
    "mcp__playwright__browser_snapshot",
    "mcp__playwright__browser_click",
    "mcp__playwright__browser_type",
    "mcp__playwright__browser_press_key",
    "mcp__playwright__browser_find",
    "mcp__playwright__browser_wait_for",
    "mcp__playwright__browser_tabs",
    "mcp__playwright__browser_take_screenshot",
    "mcp__playwright__browser_close"
  ],
  "mcp_servers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"],
      "persistent": true
    }
  },
  "max_turns": 40,
  "max_runtime_s": 600
}
EOF

echo "Created $HOME/.amon/agents/web-crawler.json"





