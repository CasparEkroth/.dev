#!/usr/bin/env bash

BASE_URL="https://www.google.com/search?q="
all="$*"

search="$BASE_URL$all"

if [[ "$OSTYPE" == "darwin"* ]]; then
    open "$search"
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    xdg-open "$search"
elif [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then 
    start "$search"
else
    echo "The operating system is not supported."
fi
