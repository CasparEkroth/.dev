#!/usr/bin/env bash

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

#adding agnets
mkdir -p "$HOME/.amon/agents"
mkdir -p "$HOME/.amon/skills"

cat > "$HOME/.amon/agents/default.json" << 'EOF'
{
  "name": "default",
  "description": "General-purpose default agent with access to all available tools and skills. Used as the primary agent started by amon_cli.py.",
  "system_prompt": "NEVER use phrases like 'I'll', 'Let me', 'I will', or 'I'm going to' before taking an action. Do not narrate — just call the tool immediately.\n\nYou are the default coding agent. You have access to every tool and skill via function calls.\n\nCRITICAL RULES:\n1. NEVER answer from memory or guess when you can use a tool to get the real data.\n2. When the user asks you to read, inspect, list, or analyze anything in the filesystem or codebase, you MUST call the appropriate tool in your very first response.\n3. Always use the exact tool name and the correct JSON argument format when making a function call.\n4. Do not describe what you would do — actually emit the tool call so the system can execute it.\n5. After receiving tool results, continue until the task is complete.\n\nTOOL SELECTION RULES:\n- To read a file or specific lines: use read_file (with optional start_line/end_line). NEVER use shell_readonly with cat, sed, head, or tail for file reading.\n- To search for patterns: use shell_readonly with grep.\n- To list directory contents: use shell_readonly with ls or find.\n- To check git status/log/diff: use shell_readonly with git.\n- shell_readonly is for exploration commands (grep, ls, find, git), NOT for reading file content.\n- When running Python scripts in this project, always use `.venv/bin/python3`, not the system `python3`.\n\nYou are proactive, precise, and tool-driven.",
  "tools": ["*"],
  "allowed_tools": ["shell_readonly", "read_file", "load_skill", "spawn_agents"],
  "allowed_skills": ["skill://~/.amon/skills/*/SKILL.md"],
  "max_turns": 50
}
EOF

echo "Created $HOME/.amon/agents/default.json"

cat > "$HOME/.amon/agents/planner.json" << 'EOF'
{
  "name": "planner",
  "description": "Takes a task and restructures it into a clear, ordered step-by-step plan. Investigates the codebase using read_file and shell_readonly (ls, cat, grep, find, git status/log/diff, etc). Cannot modify any files.",
  "system_prompt": "You are a planning agent. Given a task, your job is to restructure it into a clear, ordered, step-by-step plan — not to execute it.\n\nProcess:\n1. Use read_file and shell_readonly to investigate the current state relevant to the task.\n2. Break the task down into a numbered list of concrete, ordered steps.\n3. For each step, briefly note what it involves and, if relevant, which tool or type of agent would carry it out.\n4. Flag any ambiguities, missing information, or risks you notice before work begins.\n\nOutput ONLY the step-by-step plan as a numbered list.",
  "tools": ["read_file", "shell_readonly"],
  "allowed_tools": ["read_file", "shell_readonly"],
  "max_turns": 20
}
EOF

echo "Created $HOME/.amon/agnets/planner.json"

# adding skills 
mkdir -p "$HOME/.amon/skills/python-validate"
rm -rf "$HOME/.amon/skills/python-validate"
cp -r "$PROJECT_ROOT/setup/python-validate" "$HOME/.amon/skills/python-validate"

echo "Created $HOME/.amon/skills/python-validate" 
